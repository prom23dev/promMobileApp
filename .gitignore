# Dependencies / build output
node_modules/
.expo/
dist/
build/
__pycache__/

# Env / secrets
.env*
!.env.example
*.pem
*.key
*.p12
*.p8
*.secret
*.mobileprovision
*.keystore
!debug.keystore

# SSH private keys (never commit, even if copied in by mistake)
id_rsa
id_rsa*
id_ed25519
id_ed25519*
!id_ed25519*.pub
.ssh/

# Private runtime configs (filled from ops/runtime-stage0 templates — never commit real values)
**/config.private.php
**/*.sqlite
**/*.sqlite-wal
**/*.sqlite-shm

# Archives / local artifacts
*.tar.gz
*.zip

# OS cruft
.DS_Store
Thumbs.db
