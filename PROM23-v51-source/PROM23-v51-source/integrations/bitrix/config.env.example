# Server-only deployment template. Never bundle this file or the key into a native/web client.
# All integrations remain disabled by default. No CRM/1C/payment webhook is accepted here.
PROM23_BITRIX_READ_ENABLED=0
PROM23_BITRIX_ALLOWED_ORIGIN=https://prom.myfast.space
PROM23_BITRIX_BRIDGE_URL=https://prom.myfast.space/local/prom23-mobile/endpoint.php
PROM23_BITRIX_BRIDGE_KEY_ID=pilot-v1
PROM23_BITRIX_BRIDGE_KEY_FILE=/private/operator-provided/prom23-bridge.key

# PHP bridge host, outside the public document root:
PROM23_BRIDGE_ENABLED=0
PROM23_BRIDGE_KEY_ID=pilot-v1
PROM23_BRIDGE_KEY_FILE=/private/operator-provided/prom23-bridge.key
PROM23_BRIDGE_NONCE_DIR=/private/operator-provided/prom23-bridge-nonces
# Explicit numeric IDs of approved test users only. Empty disables customer exports.
PROM23_BRIDGE_ALLOWED_USER_IDS=
# PHP-FPM must receive these server-side env values explicitly; do not rely on browser headers.
